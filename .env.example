# Copy to .env (make setup does this and replaces every "change_me" with a random secret).
# Never commit .env.
COMPOSE_PROJECT_NAME=gridpulse
AIRFLOW_UID=50000
POSTGRES_HOST_PORT=5433

# Postgres superuser + per-service roles
POSTGRES_PASSWORD=change_me
AIRFLOW_DB_PASSWORD=change_me
SUPERSET_DB_PASSWORD=change_me
WAREHOUSE_DB_PASSWORD=change_me
BI_READER_PASSWORD=change_me

# Airflow
AIRFLOW_FERNET_KEY=change_me_fernet
AIRFLOW_JWT_SECRET=change_me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Superset
SUPERSET_SECRET_KEY=change_me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me

# Pipeline settings
GRIDPULSE_DEMO_DAYS=7
GRIDPULSE_SEED=42
GRIDPULSE_TZ=Asia/Kolkata
